# Supabase PostgreSQL Database Connection URL (Pooler)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Project URL (Optional if using direct PostgreSQL)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Authentication Secret (for JWT tokens)
JWT_SECRET=your-secure-random-jwt-secret-string

# Vercel Cron Secret (for scheduled worker checks)
CRON_SECRET=your-secure-random-cron-secret

# Port (for local testing)
PORT=3000
