    <mxCell id="c_7" value="&lt;b&gt;SSL / TLS Certificate Engine&lt;/b&gt;&lt;br/&gt;(certs/amigo.pfx, key.pem, cert.pem)&lt;br/&gt;• Self-Signed Trusted Root CA&lt;br/&gt;• Enables HTTPS for Camera API&lt;br/&gt;• Auto-switch HTTP &amp;rarr; HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_3" vertex="1">
