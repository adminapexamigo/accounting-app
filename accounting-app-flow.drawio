    <mxCell id="c_6" value="&lt;b&gt;DNS &amp;amp; Hosts Resolution&lt;/b&gt;&lt;br/&gt;127.0.0.1 amigo-enterprises.com&lt;br/&gt;• Auto-injected in Windows hosts&lt;br/&gt;• Cleaned up on server stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_3" vertex="1">
