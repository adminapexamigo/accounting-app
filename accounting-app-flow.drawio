    <mxCell id="c_18" value="&lt;b&gt;Admin Direct Login&lt;/b&gt;&lt;br/&gt;No Face / No OTP required&lt;br/&gt;Instant Admin Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_14" vertex="1">
      <mxGeometry x="600" y="55" width="180" height="55" as="geometry" />
    </mxCell>
    <mxCell id="c_19" value="&lt;b&gt;Admin Forgot Password?&lt;/b&gt;&lt;br/&gt;• Enters username&lt;br/&gt;• 6-Digit Reset Code via Gmail SMTP&lt;br/&gt;• 10m TTL / 5 tries max&lt;br/&gt;• Update password &amp;amp; auto logout all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_14" vertex="1">
      <mxGeometry x="600" y="125" width="200" height="85" as="geometry" />
    </mxCell>
    <mxCell id="c_20" value="&lt;b&gt;Verification Choice&lt;/b&gt;&lt;br/&gt;Employee selects:&lt;br/&gt;[1] Face Verification&lt;br/&gt;[2] Email OTP (6-digit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_14" vertex="1">
      <mxGeometry x="395" y="220" width="180" height="75" as="geometry" />
    </mxCell>
    <mxCell id="c_21" value="&lt;b&gt;Method A: Face Recognition&lt;/b&gt;&lt;br/&gt;• Camera captures frame&lt;br/&gt;• &lt;b&gt;face-api.js&lt;/b&gt; generates 128-d vector&lt;br/&gt;• Euclidean distance &amp;le; 0.5 threshold&lt;br/&gt;• Compared with enrolled descriptor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_14" vertex="1">
      <mxGeometry x="240" y="340" width="220" height="95" as="geometry" />
    </mxCell>
    <mxCell id="c_22" value="&lt;b&gt;Method B: Email OTP&lt;/b&gt;&lt;br/&gt;• 6-digit random code generated&lt;br/&gt;• Built-in SMTP over TLS via Gmail&lt;br/&gt;• Sent to employee email on file&lt;br/&gt;• 10-min validity / 4 sends / 5 tries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_14" vertex="1">
      <mxGeometry x="510" y="340" width="220" height="95" as="geometry" />
    </mxCell>
    <mxCell id="c_23" value="&lt;b&gt;Authenticated Session Created&lt;/b&gt;&lt;br/&gt;• HTTP-only Cookie (sid) with 8h TTL&lt;br/&gt;• Write entry into &lt;b&gt;logins.csv&lt;/b&gt;&lt;br/&gt;• Load UI Profile &amp;amp; Role Permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_14" vertex="1">
