    <mxCell id="c_14" value="🔐 2. DUAL-ROLE AUTHENTICATION &amp; MULTI-FACTOR VERIFICATION FLOW" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#0f766e;strokeColor=#134e4a;fontColor=#ffffff;rounded=1;shadow=1;fontSize=14;fontFamily=Segoe UI;" parent="1" vertex="1">
