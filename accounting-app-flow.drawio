    <mxCell id="c_5" value="&lt;b&gt;AmigoLauncher Helper&lt;/b&gt;&lt;br/&gt;(launcher.js + run-hidden.vbs)&lt;br/&gt;• Windows Scheduled Task&lt;br/&gt;• Elevated Port 80/443 listener&lt;br/&gt;• Dynamic hosts file update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_3" vertex="1">
