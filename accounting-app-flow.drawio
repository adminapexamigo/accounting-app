    <mxCell id="c_43" value="🧾 4. BILLING &amp; COMMERCIAL ORDERS PIPELINE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;rounded=1;shadow=1;fontSize=14;fontFamily=Segoe UI;" parent="1" vertex="1">
