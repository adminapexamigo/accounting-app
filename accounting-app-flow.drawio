    <mxCell id="c_17" value="Role?&lt;br/&gt;Admin vs Employee" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;fontStyle=1;shadow=1;align=center;verticalAlign=middle;" parent="c_14" vertex="1">
