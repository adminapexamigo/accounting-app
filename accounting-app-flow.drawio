    <mxCell id="c_4" value="&lt;b&gt;Amigo Control.html&lt;/b&gt;&lt;br/&gt;Desktop 1-Click GUI&lt;br/&gt;• Start Server &amp;amp; Launch Browser&lt;br/&gt;• Stop Server &amp;amp; Clear Hosts&lt;br/&gt;• Token Auth (127.0.0.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_3" vertex="1">
