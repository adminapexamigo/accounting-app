    </mxCell>
    <mxCell id="c_8" value="&lt;b&gt;Client Browser &amp;amp; Hardware&lt;/b&gt;&lt;br/&gt;• Chrome / Edge / Firefox&lt;br/&gt;• WebCam Video Feed Access&lt;br/&gt;• Single-Page Web App (index.html)&lt;br/&gt;• Responsive Desktop UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_3" vertex="1">
