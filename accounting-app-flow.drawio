    <mxCell id="c_9" value="&lt;b&gt;Zero-Dependency Node.js Backend&lt;/b&gt;&lt;br/&gt;(server.js)&lt;br/&gt;• Built-in http/https, tls, crypto, fs, zlib&lt;br/&gt;• Zero external npm packages&lt;br/&gt;• Atomic file writes &amp;amp; Chained mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_3" vertex="1">
