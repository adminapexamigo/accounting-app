    <mxCell id="c_45" value="📋 &lt;b&gt;Proforma Invoice (PI)&lt;/b&gt;&lt;br/&gt;• Commercial Proforma Billing&lt;br/&gt;• Auto numbering (AEPI-26-27-011)&lt;br/&gt;• P&amp;amp;F charges &amp;amp; Discount %&lt;br/&gt;• GST breakdown (Intra/Inter state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;shadow=1;" parent="c_43" vertex="1">
