    <mxCell id="c_16" value="&lt;b&gt;Password Verification&lt;/b&gt;&lt;br/&gt;Scrypt Hash &amp;amp; Salt Match&lt;br/&gt;crypto.timingSafeEqual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#14b8a6;fontColor=#1e293b;fontFamily=Segoe UI;fontSize=12;fontStyle=0;shadow=1;" parent="c_14" vertex="1">
