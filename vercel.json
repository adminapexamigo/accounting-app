{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/check-inactivity",
      "schedule": "30 1 * * *"
    }
  ]
}
